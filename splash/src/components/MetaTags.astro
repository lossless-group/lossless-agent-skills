---
import { STATIC_SEO, DEFAULT_OG, OG_IMAGE_STACK, TWITTER_OG } from '@lib/seo';

interface Props {
  title: string;
  description?: string;
  /** Per-page custom OG image URL. When set, replaces the default multi-image stack. */
  ogImage?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
  ogImageType?: string;
  ogImageAlt?: string;
  ogType?: string;
  noindex?: boolean;
  canonical?: string;
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
  tags?: string[];
  /** Optional JSON-LD payload for GEO. Stringified Article / BlogPosting schema. */
  jsonLd?: string;
}

const {
  title,
  description = STATIC_SEO.root.description,
  ogImage,
  ogImageWidth,
  ogImageHeight,
  ogImageType,
  ogImageAlt,
  ogType = 'website',
  noindex = false,
  canonical,
  publishedTime,
  modifiedTime,
  author,
  tags,
  jsonLd,
} = Astro.props;

const fullTitle = title.endsWith(STATIC_SEO.titleSuffix)
  ? title
  : `${title}${STATIC_SEO.titleSuffix}`;

const base = import.meta.env.BASE_URL;
const site = Astro.site?.toString().replace(/\/$/, '') ?? '';
const resolveUrl = (url: string) =>
  url.startsWith('http') ? url : `${site}${base}${url}`.replace(/([^:])\/\//g, '$1/');

// If a per-page custom ogImage is provided, use it as the sole og:image
// (suppressing the default multi-image stack). Otherwise emit the priority-
// ordered stack so chat-preview clients pick the first entry (Square),
// while best-fit aggregators can choose among the alternatives.
const imageStack = ogImage
  ? [{
      url: ogImage,
      width: ogImageWidth ?? DEFAULT_OG.width,
      height: ogImageHeight ?? DEFAULT_OG.height,
      type: ogImageType ?? DEFAULT_OG.type,
      alt: ogImageAlt ?? DEFAULT_OG.alt,
    }]
  : OG_IMAGE_STACK;

// Twitter Card summary_large_image requires 16:9. Use the explicit Banner
// from the stack unless the caller overrode with a custom ogImage.
const twitterImg = ogImage
  ? { url: ogImage, alt: ogImageAlt ?? DEFAULT_OG.alt }
  : { url: TWITTER_OG.url, alt: TWITTER_OG.alt };

const canonicalUrl = canonical ?? new URL(Astro.url.pathname, Astro.site).toString();
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
{noindex && <meta name="robots" content="noindex,nofollow" />}
<link rel="canonical" href={canonicalUrl} />

<meta property="og:type" content={ogType} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:site_name" content={STATIC_SEO.siteName} />

{imageStack.map((img) => (
  <>
    <meta property="og:image" content={resolveUrl(img.url)} />
    <meta property="og:image:secure_url" content={resolveUrl(img.url)} />
    <meta property="og:image:width" content={String(img.width)} />
    <meta property="og:image:height" content={String(img.height)} />
    <meta property="og:image:type" content={img.type} />
    <meta property="og:image:alt" content={img.alt} />
  </>
))}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={resolveUrl(twitterImg.url)} />
<meta name="twitter:image:alt" content={twitterImg.alt} />

{publishedTime && <meta property="article:published_time" content={publishedTime} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
{author && <meta property="article:author" content={author} />}
{tags?.map((tag) => <meta property="article:tag" content={tag} />)}

{jsonLd && <script type="application/ld+json" set:html={jsonLd} />}
